// Copy this file to Config/Local.xcconfig (git-ignored) and fill it in.
//
// List the identities on this Mac:
//   security find-identity -v -p codesigning
//
// CODE_SIGN_IDENTITY is the full name in quotes from that list, without the quotes.
// DEVELOPMENT_TEAM is the certificate's OU field (not the id in brackets in its name):
//   security find-certificate -c "<identity name>" -p | openssl x509 -noout -subject
// Leave DEVELOPMENT_TEAM empty for a self-signed certificate.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development: you@example.com (XXXXXXXXXX)
DEVELOPMENT_TEAM = XXXXXXXXXX
